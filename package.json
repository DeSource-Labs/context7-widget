{
  "name": "context7-widget-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "clean": "pnpm -r --if-present --stream run clean",
    "clean:modules": "pnpm -r --if-present --stream run clean:modules && rimraf node_modules",
    "build": "pnpm -r --filter \"./packages/**\" --stream run build",
    "dev:site": "pnpm --filter @desource/context7-widget-site dev",
    "scan:upstream": "node scripts/scan-upstream.mjs",
    "test:all": "pnpm test:unit && pnpm test:e2e",
    "test:e2e": "pnpm -r --filter \"./packages/**\" --if-present --stream --workspace-concurrency=1 run test:e2e",
    "test:unit": "pnpm -r --filter \"./packages/**\" --if-present --stream run test:unit",
    "test:unit:coverage": "pnpm -r --filter \"./packages/**\" --if-present --stream run test:unit:coverage",
    "typecheck": "pnpm -r --filter \"./packages/**\" --if-present --stream run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{svelte,vue,js,jsx,cjs,mjs,ts,tsx,cts,mts,json,md}\"",
    "format:check": "prettier --check \"**/*.{svelte,vue,js,jsx,cjs,mjs,ts,tsx,cts,mts,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-svelte": "^3.20.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "rimraf": "^6.1.3",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "~5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1"
  }
}
