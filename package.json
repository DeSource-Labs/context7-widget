{
  "name": "context7-widget-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build:all": "pnpm -r --workspace-concurrency=1 build",
    "dev:site": "pnpm --filter @desource/context7-widget-site dev",
    "lint:all": "pnpm -r lint",
    "scan:upstream": "node scripts/scan-upstream.mjs",
    "test:all": "pnpm -r --if-present test"
  }
}
