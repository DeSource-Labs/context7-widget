{
  "name": "@desource/context7-widget",
  "version": "0.1.0",
  "description": "Themeable Context7-compatible chat widget with a one-line replacement loader.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./widget.js": "./dist/widget.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && pnpm build:esm && pnpm build:widget && pnpm copy:public",
    "build:esm": "tsup src/index.ts --format esm --dts --sourcemap --out-dir dist",
    "build:widget": "esbuild src/auto.ts --bundle --format=iife --global-name=Context7WidgetLoader --minify --sourcemap --outfile=dist/widget.js",
    "copy:public": "node scripts/copy-public.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "scan:upstream": "node scripts/scan-upstream.mjs"
  },
  "packageManager": "pnpm@11.10.0",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
