{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter demo vercel-build",
  "outputDirectory": "demo/.output",
  "headers": [
    {
      "source": "/widget.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
