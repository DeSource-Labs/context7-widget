{
  "name": "@desource/context7-widget-svelte",
  "version": "0.1.0",
  "description": "Svelte 5 component and reactive controller for the customizable Context7 documentation chat widget.",
  "keywords": [
    "context7",
    "context7-widget",
    "svelte",
    "svelte5",
    "chat-widget",
    "ai-docs",
    "docs-chat",
    "documentation",
    "svelte-component",
    "typescript",
    "customizable",
    "themeable"
  ],
  "author": "Stefan Popov <stefan@desourcelabs.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeSource-Labs/context7-widget.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/DeSource-Labs/context7-widget/issues"
  },
  "homepage": "https://github.com/DeSource-Labs/context7-widget/tree/main/packages/svelte#readme",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "clean": "rimraf dist .svelte-kit tsconfig.tsbuildinfo test-results coverage",
    "clean:modules": "rimraf node_modules",
    "build": "pnpm clean && pnpm build:package && pnpm build:css",
    "build:package": "svelte-package --input src --output dist --tsconfig tsconfig.json",
    "build:css": "sass styles.scss dist/styles.css --no-source-map --style=compressed",
    "dev:demo": "vite demo --config demo/vite.config.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov --coverage.reportsDirectory=coverage"
  },
  "dependencies": {
    "@desource/context7-widget": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.20.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6"
  }
}
