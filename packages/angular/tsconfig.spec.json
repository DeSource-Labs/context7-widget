{
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "declaration": false,
    "noEmit": false,
    "rootDir": "../..",
    "paths": {
      "@common/*": ["../../common/*"]
    },
    "types": ["node", "vitest/globals"]
  },
  "angularCompilerOptions": {
    "compilationMode": "full",
    "strictTemplates": true
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.mts",
    "tests/**/*.ts",
    "../../common/tests/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": []
}
