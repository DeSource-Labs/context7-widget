{
  "name": "@desource/context7-widget-vue",
  "version": "0.1.0",
  "description": "Vue 3 bindings for the themeable Context7 widget.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && pnpm build:js && pnpm build:css",
    "build:css": "sass src/styles.scss dist/styles.css --no-source-map",
    "build:js": "vite build",
    "lint": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@desource/context7-widget": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "sass": "^1.101.0",
    "vite-plugin-dts": "^5.0.3",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.7"
  }
}
