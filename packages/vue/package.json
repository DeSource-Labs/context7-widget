{
  "name": "@desource/context7-widget-vue",
  "version": "0.1.0",
  "description": "Native Vue 3 component and composable for a customizable Context7 documentation chat widget.",
  "keywords": [
    "context7",
    "context7-widget",
    "widget",
    "chat-widget",
    "ai-docs",
    "docs-chat",
    "vue",
    "vue3",
    "component",
    "composable",
    "docs",
    "documentation",
    "chat",
    "typescript",
    "customizable",
    "themeable"
  ],
  "author": "Stefan Popov <stefan@desource-labs.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeSource-Labs/context7-widget.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/DeSource-Labs/context7-widget/issues"
  },
  "homepage": "https://github.com/DeSource-Labs/context7-widget/tree/main/packages/vue#readme",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo test-results coverage",
    "clean:modules": "rimraf node_modules",
    "build": "pnpm clean && pnpm build:js && pnpm build:css",
    "build:css": "sass src/styles.scss dist/styles.css --no-source-map",
    "build:js": "vite build",
    "dev:demo": "vite demo",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov --coverage.reportsDirectory=coverage"
  },
  "dependencies": {
    "@desource/context7-widget": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "sass": "^1.101.0",
    "vite-plugin-dts": "^5.0.3",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.7"
  }
}
