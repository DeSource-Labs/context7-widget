{
  "name": "@desource/context7-widget",
  "version": "0.1.0",
  "description": "Themeable Context7-compatible chat widget with a one-line replacement loader.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "import": "./dist/kit.js"
    },
    "./widget.js": "./dist/widget.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist coverage tsconfig.tsbuildinfo",
    "clean:modules": "rimraf node_modules",
    "build": "pnpm clean && pnpm build:esm && pnpm build:widget",
    "build:esm": "vite build --config vite.config.ts",
    "build:widget": "vite build --config vite.widget.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov --coverage.reportsDirectory=coverage"
  },
  "devDependencies": {
    "vite-plugin-dts": "^5.0.3"
  }
}
