{
  "name": "@desource/context7-widget-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run prepare:deps && nuxt generate",
    "dev": "pnpm run prepare:deps && nuxt dev",
    "lint": "pnpm run prepare:deps && nuxt typecheck",
    "prepare:deps": "pnpm --filter @desource/context7-widget build && pnpm --filter @desource/context7-widget-vue build && node scripts/sync-widget.mjs",
    "preview": "nuxt preview"
  },
  "dependencies": {
    "@desource/context7-widget": "workspace:*",
    "@desource/context7-widget-vue": "workspace:*",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.4.8",
    "postprocessing": "^6.39.2",
    "three": "^0.185.1",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "sass": "^1.101.0",
    "vue-tsc": "^3.3.7"
  }
}
